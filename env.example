# Traceo configuration — copy to .env and edit. Never commit .env.
#   cp env.example .env
# Every value is optional in development; the marked ones are REQUIRED in production.

# ---------------------------------------------------------------------------
# Deployment mode
# ---------------------------------------------------------------------------
# development | production. In production the backend refuses to start unless
# TRACEO_SECRET_KEY is set to a unique value and TRACEO_SEED_DEMO=0.
TRACEO_ENV=development

# REQUIRED IN PRODUCTION. Generate with: openssl rand -hex 32
# The built-in development default is published in the source, so anything signed
# with it can be forged by anyone who can read this repository.
TRACEO_SECRET_KEY=

# Seeds the demo organisation and its two accounts. Their password appears in the
# documentation, so this MUST be 0 in production.
TRACEO_SEED_DEMO=1

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Inside the containers these default to the /data volume; override only when
# running outside Docker. Python expects a SQLAlchemy URL (sqlite:////abs/path),
# Go expects a plain file path.
# TRACEO_DATABASE_URL=
# TRACEO_STORAGE_DIR=

# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------
# mock keeps the stack fully offline (required for air-gapped installs, NFR-D1).
# anthropic and gemini both make outbound calls and each needs its own key.
# auto picks anthropic if ANTHROPIC_API_KEY is set, else gemini if a Google key
# is set, else mock — so an unconfigured checkout still runs offline.
TRACEO_LLM_PROVIDER=mock
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=            # GOOGLE_API_KEY is accepted as an alias
# TRACEO_GEMINI_MODEL=gemini-3.5-flash
# Model calls, unlike calls to the system under test, are allowed to be slow;
# thinking models spend the token budget on reasoning before the answer.
# TRACEO_LLM_TIMEOUT_S=120
# TRACEO_LLM_MAX_TOKENS=8192

# --- self-hosted model (air-gapped deployments) -----------------------------
# Any server speaking the OpenAI chat-completions shape: Ollama, llama.cpp,
# vLLM, TGI. Setting a base URL is what makes the provider available; with
# TRACEO_LLM_PROVIDER=auto it WINS over the cloud providers, because an operator
# who stood one up inside the perimeter did so precisely so nothing calls out.
# The provider negotiates structured output downward — json_schema, then
# json_object, then neither — so servers of different vintages all work.
# TRACEO_LOCAL_LLM_BASE_URL=http://ollama:11434/v1
# TRACEO_LOCAL_LLM_MODEL=qwen2.5-coder:7b
# TRACEO_LOCAL_LLM_API_KEY=

# ---------------------------------------------------------------------------
# Networking
# ---------------------------------------------------------------------------
# Comma-separated allowed browser origins for the API.
TRACEO_CORS_ORIGINS=http://localhost:3000
# The API URL baked into the frontend bundle at build time — must be reachable
# from the BROWSER, not from inside the compose network.
NEXT_PUBLIC_API=http://localhost:8000/v1

# ---------------------------------------------------------------------------
# Execution engine (tuning; defaults are usually fine)
# ---------------------------------------------------------------------------
# TRACEO_RUN_CONCURRENCY=8
# TRACEO_REQUEST_TIMEOUT_S=30
# TRACEO_RUN_TIMEOUT_S=600
