.DS_Store
**/.DS_Store
backend/.venv/
backend/storage/
backend/*.db
frontend/node_modules/
frontend/.next/
__pycache__/
**/__pycache__/
.pytest_cache/

# Real configuration and secrets; env.example is the committed template.
.env
.env.*
!env.example

# Go backend local state
backend-go/*.db
backend-go/storage/

frontend/tsconfig.tsbuildinfo

# Dependency trees and local interpreters that were not covered above.
# Committing these adds ~70MB of other people's code to every clone.
e2e/node_modules/
demo/sut/.venv/
tools/web-discovery/node_modules/
**/.venv/

# Playwright output
e2e/test-results/
e2e/playwright-report/
e2e/blob-report/
e2e/.auth/

# Session backups (local safety copies, never part of the project)
*.bak

# Run artefacts: recordings and failure frames, regenerated by every run.
backend/storage/
